* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  font-family: Arial, "Noto Sans Bengali", sans-serif;
  color: #f5f5ff;
  background: #080816;
}

body {
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 10%, #25104a 0, transparent 35%),
    radial-gradient(circle at 90% 30%, #101d45 0, transparent 35%),
    #080816;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  width: min(1100px, 94%);
  margin: auto;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 22px 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  font-weight: 900;
  background: linear-gradient(135deg, #ff00cc, #3333ff, #00eaff);
  box-shadow: 0 0 22px #a000ff88;
}

.brand h1 {
  font-size: 19px;
}

.brand p {
  color: #aaaac5;
  font-size: 12px;
  margin-top: 5px;
}

.admin-button, button {
  border: 0;
  border-radius: 10px;
  padding: 11px 17px;
  color: white;
  background: linear-gradient(110deg, #a000ff, #ec008c);
}

.hero {
  margin: 30px 0;
  padding: 65px 25px;
  text-align: center;
  border: 1px solid #8b35ff66;
  border-radius: 24px;
  background: linear-gradient(135deg, #17102e, #11152e);
  box-shadow: 0 0 35px #7700ff22;
}

.hero-tag, .small-label {
  color: #00eaff;
  font-size: 11px;
  letter-spacing: 2px;
}

.hero h2 {
  font-size: clamp(25px, 5vw, 42px);
  margin: 20px 0 12px;
  background: linear-gradient(90deg, #ff42c8, #8d8dff, #00eaff);
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

.hero p {
  color: #c2c2d8;
  line-height: 1.8;
}

.rgb-line {
  height: 3px;
  margin-top: 25px;
  border-radius: 10px;
  background: linear-gradient(90deg, #ff00cc, #7a00ff, #00eaff, #00ff88, #ffcc00);
  background-size: 200% 100%;
  animation: rgb 4s linear infinite;
}

@keyframes rgb {
  to { background-position: 200% 0; }
}

.tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin: 25px 0;
}

.tab {
  background: #17172b;
  border: 1px solid #343454;
  color: #c9c9e2;
  padding: 15px 8px;
  border-radius: 13px;
}

.tab span {
  display: block;
  font-size: 22px;
  margin-bottom: 7px;
}

.tab.active {
  border-color: #c000ff;
  background: #35104d;
  box-shadow: 0 0 18px #a000ff44;
  color: white;
}

.content-section {
  margin: 35px 0;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-heading h2 {
  margin-top: 8px;
}

.count {
  color: #00eaff;
  background: #092c39;
  padding: 8px 14px;
  border-radius: 20px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 15px;
}

.item-card, .login-box, .admin-form {
  padding: 22px;
  border: 1px solid #383858;
  border-radius: 16px;
  background: #151529;
  margin-bottom: 15px;
}

.item-card {
  border-left: 3px solid #b000ff;
  overflow-wrap: anywhere;
}

.card-date {
  color: #00eaff;
  font-size: 12px;
}

.item-card h3 {
  margin: 13px 0;
  color: #fff;
}

.item-card p {
  color: #c5c5d8;
  line-height: 1.8;
  white-space: pre-wrap;
}

.empty {
  text-align: center;
  color: #aaaac5;
  padding: 35px 10px;
  background: #151529;
  border-radius: 15px;
}

.admin-form h2, .login-box h2 {
  margin-bottom: 18px;
}

.admin-form input, .admin-form textarea,
.login-box input {
  display: block;
  width: 100%;
  margin: 12px 0;
  padding: 14px;
  color: white;
  background: #09091a;
  border: 1px solid #48486b;
  border-radius: 10px;
  outline: none;
}

input:focus, textarea:focus {
  border-color: #00eaff;
}

.admin-form button, .login-box button {
  margin: 7px 7px 0 0;
}

.cancel-button {
  background: #44445c;
}

.card-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.card-actions button:last-child {
  background: #a52243;
}

footer {
  text-align: center;
  padding: 25px 0 35px;
  color: #aaaac5;
}

footer h3 {
  color: white;
  margin-bottom: 8px;
}

footer p {
  font-size: 13px;
}

@media (max-width: 600px) {
  .header {
    flex-wrap: wrap;
  }

  .brand h1 {
    font-size: 16px;
  }

  .hero {
    padding: 45px 15px;
  }

  .tabs {
    grid-template-columns: repeat(2, 1fr);
  }

  .admin-button {
    padding: 10px 12px;
  }
}
